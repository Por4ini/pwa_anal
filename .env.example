POSTGRES_DB=pwa_analytics
POSTGRES_USER=pwa_analytics
POSTGRES_PASSWORD=change-me-database-password
DJANGO_SECRET_KEY=change-me-long-random-secret
DASHBOARD_TOKEN=change-me-dashboard-token
ANALYTICS_IP_HASH_SALT=change-me-dedicated-ip-hash-salt
ANALYTICS_GATEWAY_PORT=67
ANALYTICS_REQUESTS_PER_MINUTE=240
ANALYTICS_RETENTION_DAYS=730
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.squadras.cc
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://pwa.ordr.bz:8000
# Collector is public and receives events from many tenant storefront domains.
# Dashboard reads still require DASHBOARD_TOKEN.
CORS_ALLOW_ALL_ORIGINS=true
